# =============================================================================
# AWS Community Showcase — Environment Variables Template
# =============================================================================
# Copy this to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from: Supabase Dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project ref (used by `supabase link` / migrations)
SUPABASE_PROJECT_REF=your-project-ref

# -----------------------------------------------------------------------------
# Countdown Timer (Requirement 2)
# Target datetime in ISO 8601 format (UTC) and IANA timezone identifier
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COUNTDOWN_TARGET=2026-12-31T23:59:59Z
NEXT_PUBLIC_COUNTDOWN_TIMEZONE=Asia/Manila

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
